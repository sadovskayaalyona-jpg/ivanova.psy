NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Секретный ключ — только на сервере, не NEXT_PUBLIC_. Нужен для генерации
# персональных стратегий в разделе «Путь к балансу». Без него используется
# запасной шаблонный текст (сайт не ломается).
ANTHROPIC_API_KEY=

# Секретный ключ — только на сервере, НИКОГДА не NEXT_PUBLIC_. Обходит все
# правила защиты (RLS) — нужен только для админ-раздела /admin, чтобы видеть
# результаты всех клиентов. Supabase → Settings → API Keys → вкладка Legacy
# anon, service_role API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=
